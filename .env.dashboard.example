# Copiar a .env.dashboard.local y completar SOLO en el ordenador de cada persona.
# Esta plantilla no contiene credenciales. No subir el archivo completado.
DASHBOARD_DB_MODE=environment
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=tfm_energia
PGUSER=REEMPLAZAR_USUARIO_SOLO_LECTURA
PGPASSWORD=REEMPLAZAR_CONTRASENA

# Sin contraseña de equipo SOLO para una API ligada a 127.0.0.1.
# Nunca utilizar esta configuración en el VPS ni abrirla con un túnel público.
DASHBOARD_REQUIRE_AUTH=0
DASHBOARD_ALLOWED_ORIGINS=http://localhost:3000
