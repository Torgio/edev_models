[Unit]
Description=Pulso Energia - API de consulta
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/pulso-api
EnvironmentFile=/etc/pulso-api.env
Environment=DASHBOARD_DB_MODE=environment
Environment=DASHBOARD_REQUIRE_AUTH=1
LoadCredential=team-auth:/etc/pulso-api-auth.json
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/ubuntu/pulso-api/.venv/bin/python -m uvicorn api.dashboard_api:app --host 127.0.0.1 --port 8000 --workers 1 --limit-concurrency 16 --timeout-keep-alive 5
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
UMask=0077

[Install]
WantedBy=multi-user.target
