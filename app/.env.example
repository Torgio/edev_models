# Solo el servidor web conoce la dirección del backend. Nunca incluir contraseñas aquí.
DASHBOARD_API_URL=http://127.0.0.1:8000
# Servicio del asistente. En local suele ejecutarse en el puerto 8010.
ASSISTANT_API_URL=http://127.0.0.1:8010
# Prueba local de estudios guardados: IDs permitidos, separados por comas.
# Necesita que DASHBOARD_API_URL sirva /session y /api/bat/* (el VPS ya los sirve).
# Sin IDs no se permite leer ningún estudio; la ruta siempre está desactivada en producción.
BESS_STUDY_RUN_IDS=
# En Sites (no para esta prueba local): DASHBOARD_API_URL=https://vps-16d0afbc.vps.ovh.net
# La contraseña y la firma de sesiones se configuran SOLO en el servidor de la API.
